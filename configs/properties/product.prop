# FM
ro.fm.chip=0x6631
ro.fm.band=1
ro.fm.low_band=875
ro.fm.high_band=1080
ro.fm.seek_space=1
ro.fm.max_scan_num=40
ro.fm.seek_lev=4
ro.fm.scan_sort=0
ro.fm.short_ana_sup=1
ro.fm.rssi_th_l2=-102
ro.fm.fake_chans=4
ro.fm.fake_chan_0=9210 -205
ro.fm.fake_chan_1=9600 -152
ro.fm.fake_chan_2=10400 -152
ro.fm.fake_chan_3=10750 -205

# Moto
ro.mot.build.customerid=global

# RIL
persist.vendor.mtk_rcs_ua_support=0
persist.vendor.mtk_uce_support=0
persist.vendor.vt.RTPInfo=1
persist.vendor.vt.supported=1
ril.subscription.types=RUIM
ro.surface_flinger.enable_frame_rate_override=true
ro.telephony.default_network=27,27
ro.vendor.radio.imei.sv=41
ro.com.google.lens.oem_camera_package=com.motorola.camera3

# Skia tracing
debug.hwui.skia_tracing_enabled=false
debug.hwui.skia_use_perfetto_track_events=false

